# Host port exposed by the frontend container. Change it when 8021 is occupied.
TRUSTED_KNOWLEDGE_HOST_PORT=8021

# Oracle must be reachable from inside the backend container. Do not use
# localhost unless Oracle runs in this same container.
TRUSTED_KNOWLEDGE_DB_USER=dev_alfred
TRUSTED_KNOWLEDGE_DB_PASSWORD=replace-me
TRUSTED_KNOWLEDGE_DB_DSN=oracle.example.com:1521/orclpdb1

TRUSTED_KNOWLEDGE_ADMIN_USERNAME=admin
TRUSTED_KNOWLEDGE_ADMIN_PASSWORD=replace-me
TRUSTED_KNOWLEDGE_API_KEY=replace-me
TRUSTED_KNOWLEDGE_PERSONAL_SECRET_KEY=change-this-to-a-long-random-secret-value

TRUSTED_KNOWLEDGE_DB_POOL_MIN=1
TRUSTED_KNOWLEDGE_DB_POOL_MAX=8
TRUSTED_KNOWLEDGE_DB_POOL_INCREMENT=1
TRUSTED_KNOWLEDGE_DB_POOL_PING_INTERVAL=60
TRUSTED_KNOWLEDGE_DB_POOL_TIMEOUT=300
TRUSTED_KNOWLEDGE_DB_POOL_MAX_LIFETIME_SESSION=3600

# Optional model and publishing settings.
TRUSTED_KNOWLEDGE_HISTORY_ASK_LLM_API_KEY=
TRUSTED_KNOWLEDGE_META_WEBLOG_TIMEOUT_SECONDS=60
TRUSTED_KNOWLEDGE_AI_PRICING_JSON={}

# Set these to the public URL when enabling WeChat login.
TRUSTED_KNOWLEDGE_FRONTEND_BASE_URL=http://localhost:8021
TRUSTED_KNOWLEDGE_WECHAT_APP_ID=
TRUSTED_KNOWLEDGE_WECHAT_APP_SECRET=
TRUSTED_KNOWLEDGE_WECHAT_REDIRECT_URI=
TRUSTED_KNOWLEDGE_WECHAT_ALLOWED_OPENIDS=
TRUSTED_KNOWLEDGE_WECHAT_ALLOWED_UNIONIDS=
